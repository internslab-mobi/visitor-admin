<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty
            scope="context"
            name="appName"
            source="spring.application.name"
            defaultValue="auth"/>

    <springProperty
            scope="context"
            name="logLevel"
            source="logging.level.root"
            defaultValue="INFO"/>

    <property name="LOG_PATH" value="logs/auth"/>
    <property name="LOG_FILE" value="${LOG_PATH}/${appName}.log"/>

    <property
            name="CONSOLE_LOG_PATTERN"
            value="%gray(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}) %highlight(%-5level) %gray(${PID:- }) %gray(---) %gray([${appName}]) %gray([%thread]) %yellow([%X{requestId:-N/A}]) %cyan(%-40.40logger{39}) : %msg%n"/>

    <property
            name="FILE_LOG_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level ${PID:- } --- [${appName}] [%thread] [%X{requestId:-N/A}] %-40.40logger{39} : %msg%n"/>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_FILE}</file>

        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>${LOG_PATH}/${appName}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>

        </rollingPolicy>
    </appender>

    <appender name="CANONICAL_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>[ignore]</message>
                <logger>[ignore]</logger>
                <thread>[ignore]</thread>
                <levelValue>[ignore]</levelValue>
                <version>[ignore]</version>
                <level>[ignore]</level>
            </fieldNames>
            <includeMdc>false</includeMdc>
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <appender name="CANONICAL_JSON"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/${appName}-canonical.ndjson</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>${LOG_PATH}/${appName}-canonical.%d{yyyy-MM-dd}.%i.ndjson</fileNamePattern>

            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>

        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>[ignore]</message>
                <logger>[ignore]</logger>
                <thread>[ignore]</thread>
                <levelValue>[ignore]</levelValue>
                <version>[ignore]</version>
                <level>[ignore]</level>
            </fieldNames>
            <includeMdc>false</includeMdc>
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <logger name="canonical" level="INFO" additivity="false">
        <appender-ref ref="CANONICAL_CONSOLE"/>
        <appender-ref ref="CANONICAL_JSON"/>
    </logger>

    <logger name="io.gomobi.auth.api" level="INFO"/>
    <logger name="io.gomobi.auth.core" level="INFO"/>
    <logger name="io.gomobi.auth.application" level="INFO"/>
    <logger name="io.gomobi.auth.security" level="INFO"/>

    <logger name="com.adminvisitor.auth" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="org.springframework.jdbc" level="WARN" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

    <logger name="com.github.benmanes.caffeine" level="WARN" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

    <root level="${logLevel}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
