<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context"
                    name="appName"
                    source="spring.application.name"
                    defaultValue="api-gateway"/>

    <springProperty scope="context"
                    name="logLevel"
                    source="logging.level.root"
                    defaultValue="INFO"/>

    <property name="LOG_PATH" value="D:/VMS/logs"/>
    <property name="LOG_FILE" value="${LOG_PATH}/${appName}.log"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%cyan(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}) %highlight(%-5level) %magenta(${PID:- }) %gray(---) %blue([${appName}]) %gray([%thread]) %yellow([traceId=%X{traceId:-N/A}]) %yellow([spanId=%X{spanId:-N/A}]) %cyan(%-40.40logger{39}) : %msg%n"/>

    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level ${PID:- } --- [${appName}] [%thread] [traceId=%X{traceId:-N/A}] [spanId=%X{spanId:-N/A}] %-40.40logger{39} : %msg%n"/>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${appName}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="${logLevel}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="com.adminvisitor.gateway" level="DEBUG"/>

</configuration>
